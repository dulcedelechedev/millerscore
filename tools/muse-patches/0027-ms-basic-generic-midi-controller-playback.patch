+void FluidSequencer::addGenericControllerEvent(EventSequenceMap& destination, const mpe::timestamp_t timestamp,
+                                               const mpe::ControllerChangeEvent& event)
+{
+    const float value = event.val.raw();
+    if (timestamp < 0 || !mpe::isSafeMidiController(event.controllerNumber)
+        || !std::isfinite(value) || value < 0.f || value > 1.f) {
+        return;
+    }
+
+    const auto layer = m_channels.data().find(m_channels.normalizedLayer(event.layerIdx));
+    if (layer == m_channels.data().end()) {
+        return;
+    }
+
+    std::set<channel_t> channels;
+    for (const auto& [_, mapping] : layer->second) {
+        channels.insert(mapping.first);
+    }
+
+    const int midiValue = static_cast<int>(std::lround(value * 127.f));
+    for (const channel_t channel : channels) {
+        m_genericControllerEvents[{ channel, event.controllerNumber }][timestamp] = midiValue;
+        EventSequence& sequence = destination[timestamp];
+        // Multiple articulations may share a channel. One lane contributes one value at a timestamp.
+        auto existing = std::find_if(sequence.begin(), sequence.end(), [&](const EventType& entry) {
+            const auto* generic = std::get_if<GenericMidiControllerEvent>(&entry);
+            return generic && generic->event.channel() == channel && generic->event.index() == event.controllerNumber;
+        });
+        midi::Event cc(Event::Opcode::ControlChange, Event::MessageType::ChannelVoice10);
+        cc.setChannel(channel);
+        cc.setIndex(event.controllerNumber);
+        cc.setData(midiValue);
+        if (existing != sequence.end()) {
+            *existing = GenericMidiControllerEvent { cc };
+        } else {
+            sequence.emplace_back(GenericMidiControllerEvent { cc });
+        }
+    }
+}
+
+std::vector<FluidSequencer::ControllerValue> FluidSequencer::genericControllerKeys() const
+{
+    std::vector<ControllerValue> result;
+    for (const auto& [key, _] : m_genericControllerEvents) {
+        result.push_back({ key.first, key.second, 0 });
+    }
+    return result;
+}
+
+std::vector<FluidSequencer::ControllerValue> FluidSequencer::currentGenericControllerValues() const
+{
+    std::vector<ControllerValue> result;
+    for (const auto& [key, curve] : m_genericControllerEvents) {
+        auto it = curve.upper_bound(mpe::timestamp_t(m_playbackPosition.raw()));
+        if (it != curve.begin()) {
+            --it;
+            result.push_back({ key.first, key.second, it->second });
+        }
+    }
+    return result;
+}
