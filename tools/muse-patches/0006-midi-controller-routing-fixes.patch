diff --git a/framework/midi/tests/midievent_tests.cpp b/framework/midi/tests/midievent_tests.cpp
index b266f6f12..bf2d7e95d 100644
--- a/framework/midi/tests/midievent_tests.cpp
+++ b/framework/midi/tests/midievent_tests.cpp
@@ -235,6 +235,26 @@ TEST_F(EventTests, ToMidi10_NoteOn)
     EXPECT_EQ(events[0].messageType(), Event::MessageType::ChannelVoice10);
 }
 
+TEST_F(EventTests, ToMidi10_ProgramChangePreservesBankMsbAndLsb)
+{
+    Event e(Event::Opcode::ProgramChange, Event::MessageType::ChannelVoice20);
+    e.setProgram(42);
+    e.setBank((3u << 7) | 17u);
+    EXPECT_EQ(e.bank(), (3u << 7) | 17u);
+
+    std::vector<Event> events = e.toMIDI10();
+
+    ASSERT_EQ(events.size(), 3);
+    EXPECT_EQ(events[0].opcode(), Event::Opcode::ControlChange);
+    EXPECT_EQ(events[0].index(), 0);
+    EXPECT_EQ(events[0].data(), 3);
+    EXPECT_EQ(events[1].opcode(), Event::Opcode::ControlChange);
+    EXPECT_EQ(events[1].index(), 32);
+    EXPECT_EQ(events[1].data(), 17);
+    EXPECT_EQ(events[2].opcode(), Event::Opcode::ProgramChange);
+    EXPECT_EQ(events[2].program(), 42);
+}
