+
+TEST(MuseSamplerNativeLoaderTests, CorruptLibraryAtUnicodePathDoesNotLoad)
+{
+    QTemporaryDir fixture(QDir::tempPath() + "/millerscore sampler Å 测试-XXXXXX");
+    ASSERT_TRUE(fixture.isValid());
