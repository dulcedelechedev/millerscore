 public:
 
     virtual void forward(const TimePosition& delta) = 0;
+
+    //! Advances the position during an offline render (export): no loop,
+    //! count-in or end-of-playback handling and no position notifications,
+    //! so automation and tempo-synced effects follow the rendered audio.
+    virtual void forwardOffline(const TimePosition& delta) = 0;
 };
 
