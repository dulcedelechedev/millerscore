+void AudioFactory::releaseTrackFx(const TrackId trackId)
+{
+    // Resolving an empty chain removes every instance a resolver holds for the
+    // track, including registered plug-in instances.
+    fxResolver()->resolveFxList(trackId, AudioFxChain(), audioEngine()->outputSpec());
+}
