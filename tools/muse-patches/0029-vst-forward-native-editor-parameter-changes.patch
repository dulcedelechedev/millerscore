@@ -371,6 +371,26 @@ void VstPluginInstance::refreshConfig()
     rescanParams();
 }
 
+void VstPluginInstance::requestRefreshConfig()
+{
+    ONLY_AUDIO_THREAD(threadSecurer);
+
+    // Read processor state only after process() applied the editor values.
+    // Coalesce requests while the main thread is busy serializing a plugin.
+    if (m_configRefreshQueued.exchange(true)) {
+        return;
+    }
+    Async::call(this, [this]() {
+        m_configRefreshQueued = false;
+        rescanParams();
+    }, threadSecurer()->mainThreadId());
+}
+
+async::Channel<PluginParamId, PluginParamValue> VstPluginInstance::pluginParamChanged() const
+{
+    return m_componentHandlerPtr->pluginParamChanged();
+}
+
 bool VstPluginInstance::isLoaded() const
 {
     ONLY_AUDIO_OR_MAIN_THREAD(threadSecurer);
