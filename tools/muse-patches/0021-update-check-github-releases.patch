+{
+    //! [GIVEN] A GitHub release with source archives but no installable asset
+    const QByteArray json = R"json({
+        "tag_name": "v0.2.0",
+        "html_url": "https://github.com/dulcedelechedev/millerscore/releases/tag/v0.2.0",
+        "body": "MillerScore 0.2.0 release notes",
+        "assets": []
+    })json";
+
+    //! [WHEN] The release is parsed
+    const RetVal<ReleaseInfo> result = m_service->parseRelease(json);
+
+    //! [THEN] It remains valid and delegates the authenticated update to itch.io
+    ASSERT_TRUE(result.ret);
+    EXPECT_EQ(result.val.version, "0.2.0");
+    EXPECT_TRUE(result.val.fileName.empty());
+    EXPECT_EQ(result.val.fileUrl, "itch://install?game_id=5065105");
+    EXPECT_EQ(result.val.notes, "MillerScore 0.2.0 release notes");
+}
