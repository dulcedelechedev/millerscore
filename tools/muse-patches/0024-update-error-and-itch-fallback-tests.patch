+TEST_F(AppUpdateServiceTests, CheckForUpdate_ImmediateOfflineFailureSettlesPromise)
+{
+    givenAvailableRelease();
+    const Ret offline = muse::network::make_ret(muse::network::Err::NetworkError);
+    EXPECT_CALL(*m_networkManager, get(_, _, _))
+    .WillOnce(Return(RetVal<Progress>::make_ret(offline)));
+    bool settled = false;
+    RetVal<ReleaseInfo> result;
+    m_service->checkForUpdate().onResolve(this, [&settled, &result](const RetVal<ReleaseInfo>& value) {
+        settled = true;
+        result = value;
+    });
+    async::processMessages();
+    EXPECT_TRUE(settled);
+    EXPECT_EQ(result.ret.code(), offline.code());
+    EXPECT_TRUE(result.val.version.empty());
+    EXPECT_TRUE(result.val.fileName.empty());
+}
+
+TEST_F(AppUpdateServiceTests, CheckForUpdate_Http404AndRateLimitAreRecoverable)
+{
+    for (const int status : { 404, 429, 503 }) {
+        SCOPED_TRACE(status);
+        Progress request;
+        EXPECT_CALL(*m_networkManager, get(_, _, _))
+        .WillOnce(Return(RetVal<Progress>::make_ok(request)));
+        bool settled = false;
+        RetVal<ReleaseInfo> result;
+        m_service->checkForUpdate().onResolve(this, [&settled, &result](const RetVal<ReleaseInfo>& value) {
+            settled = true;
+            result = value;
+        });
+        async::processMessages();
+        Ret failure = muse::network::make_ret(muse::network::Err::NetworkError);
+        failure.setData("status", status);
+        request.finish(ProgressResult::make_ret(failure));
+        async::processMessages();
+        EXPECT_TRUE(settled);
+        EXPECT_EQ(result.ret.code(), failure.code());
+        EXPECT_EQ(result.ret.data("status", 0), status);
+        EXPECT_TRUE(result.val.version.empty());
+        EXPECT_TRUE(result.val.fileUrl.empty());
+    }
+}
+
+TEST_F(AppUpdateServiceTests, CheckForUpdate_MalformedResponseSettlesWithoutDownload)
+{
+    EXPECT_CALL(*m_networkManager, get(_, _, _))
+    .WillOnce(testing::Invoke([this](const QUrl&, IncomingDevicePtr buffer, const RequestHeaders&) {
+        buffer->open(IncomingDevice::WriteOnly);
+        buffer->write("{\"tag_name\":");
+        buffer->close();
+        return RetVal<Progress>::make_ok(m_getReleaseInfoProgress);
+    }));
+    bool settled = false;
+    RetVal<ReleaseInfo> result;
+    m_service->checkForUpdate().onResolve(this, [&settled, &result](const RetVal<ReleaseInfo>& value) {
+        settled = true;
+        result = value;
+    });
+    async::processMessages();
+    m_getReleaseInfoProgress.finish(ProgressResult::make_ok({}));
+    async::processMessages();
+    EXPECT_TRUE(settled);
+    EXPECT_EQ(result.ret.code(), static_cast<int>(muse::update::Err::ReleaseInfoParseError));
+    EXPECT_TRUE(result.val.fileName.empty());
+}
