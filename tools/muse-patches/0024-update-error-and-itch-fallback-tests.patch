+TEST_F(AppUpdateServiceTests, ParseRelease_MalformedOrMissingMetadataIsRejected)
+{
+    for (const QByteArray json : { QByteArray(), QByteArray("not-json"), QByteArray("{\"tag_name\":"),
+                                  QByteArray("null"), QByteArray("[]"), QByteArray("[1]"), QByteArray("{}"),
+                                  QByteArray("{\"message\":\"Not Found\"}") }) {
+        SCOPED_TRACE(json.constData());
+        const RetVal<ReleaseInfo> result = parseRelease(json);
+        EXPECT_EQ(result.ret.code(), static_cast<int>(muse::update::Err::ReleaseInfoParseError));
+        EXPECT_TRUE(result.val.version.empty());
+        EXPECT_TRUE(result.val.fileUrl.empty());
+    }
+}
+
+TEST_F(AppUpdateServiceTests, ParseRelease_GitHubArrayRetainsSourceOnlyRouting)
+{
+    const QByteArray json = R"json([{
+        "tag_name": "v1000.0.0",
+        "body": "Release notes",
+        "assets": []
+    }])json";
+    const RetVal<ReleaseInfo> result = parseRelease(json);
+    ASSERT_TRUE(result.ret);
+    EXPECT_EQ(result.val.version, "1000.0.0");
+    EXPECT_TRUE(result.val.fileName.empty());
+    EXPECT_EQ(result.val.fileUrl, "itch://install?game_id=5065105");
+}
