+void VstFxProcessor::setConfiguration(const muse::audio::AudioUnitConfig& configuration)
+{
+    if (m_params.configuration == configuration) {
+        return;
+    }
+
+    m_params.configuration = configuration;
+
+    // Before loading completes, onPluginLoaded applies m_params.configuration.
+    if (m_inited) {
+        m_pluginPtr->updatePluginConfig(configuration);
+    }
+}
+
 void VstFxProcessor::setMode(const muse::audio::ProcessMode mode)
 {
     m_vstAudioClient->setIsPlaying(muse::audio::isModePlaying(mode));
