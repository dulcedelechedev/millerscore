@@ -120,6 +122,20 @@ void AbstractFxResolver::updateMasterFxMap(const AudioFxChain& newFxChain, const
             m_masterFxMap.emplace(pair.first, fx);
         }
     }
+
+    applyConfigurations(m_masterFxMap, newFxChain);
+}
+
+void AbstractFxResolver::applyConfigurations(const FxMap& fxMap, const AudioFxChain& newFxChain)
+{
+    // A kept slot (same resource) may carry another saved state, e.g. when a
+    // project's settings are applied again; the live instance must follow it.
+    for (const auto& pair : fxMap) {
+        auto newIt = newFxChain.find(pair.first);
+        if (newIt != newFxChain.cend() && pair.second->params().configuration != newIt->second.configuration) {
+            pair.second->setConfiguration(newIt->second.configuration);
+        }
+    }
 }
 
