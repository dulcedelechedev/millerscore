+//! Hands this cycle's input to the recording consumer (never blocks the audio thread)
+static void s_deliverInput(long index)
+{
+    const long inputs = s_adata.activeInputChannels;
+    if (inputs <= 0) {
+        return;
+    }
+    std::unique_lock<std::mutex> lock(s_adata.inputCallbackMutex, std::try_to_lock);
+    if (!lock.owns_lock() || !s_adata.inputCallback) {
+        return;
+    }
+
+    const IAudioDriver::Spec& active = s_adata.activeSpec;
+    const size_t frames = active.output.samplesPerChannel;
+    const long first = long(active.output.audioChannelCount); // inputs follow the outputs
+
+    static std::vector<float> input;
+    input.resize(frames * size_t(inputs));
+    for (long channel = 0; channel < inputs; ++channel) {
+        const void* buffer = s_adata.bufferInfos[first + channel].buffers[index];
+        const ASIOSampleType type = s_adata.channelInfos[first + channel].type;
+        for (size_t frame = 0; frame < frames; ++frame) {
+            input[frame * size_t(inputs) + size_t(channel)] = inputSampleToFloat(buffer, frame, type);
+        }
+    }
+    s_adata.inputCallback(input.data(), samples_t(frames), audioch_t(inputs), active.output.sampleRate);
+}
