+//! One ASIO input sample as a float in [-1, 1]
+static float inputSampleToFloat(const void* buffer, size_t index, ASIOSampleType type)
+{
+    const uint8_t* bytes = static_cast<const uint8_t*>(buffer);
+    switch (type) {
+    case ASIOSTInt16LSB:
+        return static_cast<const int16_t*>(buffer)[index] / 32768.0f;
+    case ASIOSTInt16MSB:
+        return int16_t(swap16(static_cast<const uint16_t*>(buffer)[index])) / 32768.0f;
+    case ASIOSTInt24LSB: {
+        const uint8_t* p = bytes + index * 3;
+        const int32_t value = int32_t(uint32_t(p[0]) << 8 | uint32_t(p[1]) << 16 | uint32_t(p[2]) << 24) >> 8;
+        return value / 8388608.0f;
+    }
+    case ASIOSTInt24MSB: {
+        const uint8_t* p = bytes + index * 3;
+        const int32_t value = int32_t(uint32_t(p[2]) << 8 | uint32_t(p[1]) << 16 | uint32_t(p[0]) << 24) >> 8;
+        return value / 8388608.0f;
+    }
+    case ASIOSTInt32LSB:
+        return float(static_cast<const int32_t*>(buffer)[index] / 2147483648.0);
+    case ASIOSTInt32MSB:
+        return float(int32_t(swap32(static_cast<const uint32_t*>(buffer)[index])) / 2147483648.0);
+    case ASIOSTFloat32LSB:
+        return static_cast<const float*>(buffer)[index];
+    case ASIOSTFloat32MSB: {
+        const uint32_t raw = swap32(static_cast<const uint32_t*>(buffer)[index]);
+        float value;
+        std::memcpy(&value, &raw, sizeof(value));
+        return value;
+    }
+    case ASIOSTFloat64LSB:
+        return float(static_cast<const double*>(buffer)[index]);
+    case ASIOSTFloat64MSB: {
+        const uint64_t raw = swap64(static_cast<const uint64_t*>(buffer)[index]);
+        double value;
+        std::memcpy(&value, &raw, sizeof(value));
+        return float(value);
+    }
+    // 32-bit containers holding 16/18/20/24-bit data in their low bits
+    case ASIOSTInt32LSB16: return static_cast<const int32_t*>(buffer)[index] / 32768.0f;
+    case ASIOSTInt32LSB18: return static_cast<const int32_t*>(buffer)[index] / 131072.0f;
+    case ASIOSTInt32LSB20: return static_cast<const int32_t*>(buffer)[index] / 524288.0f;
+    case ASIOSTInt32LSB24: return static_cast<const int32_t*>(buffer)[index] / 8388608.0f;
+    case ASIOSTInt32MSB16: return int32_t(swap32(static_cast<const uint32_t*>(buffer)[index])) / 32768.0f;
+    case ASIOSTInt32MSB18: return int32_t(swap32(static_cast<const uint32_t*>(buffer)[index])) / 131072.0f;
+    case ASIOSTInt32MSB20: return int32_t(swap32(static_cast<const uint32_t*>(buffer)[index])) / 524288.0f;
+    case ASIOSTInt32MSB24: return int32_t(swap32(static_cast<const uint32_t*>(buffer)[index])) / 8388608.0f;
