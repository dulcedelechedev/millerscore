#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @MUSE_APP_VERSION_MAJOR@,@MUSE_APP_VERSION_MINOR@,@MUSE_APP_VERSION_PATCH@,@CMAKE_BUILD_NUMBER@
 PRODUCTVERSION @MUSE_APP_VERSION_MAJOR@,@MUSE_APP_VERSION_MINOR@,@MUSE_APP_VERSION_PATCH@,@CMAKE_BUILD_NUMBER@
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "@MUSE_APP_DEVELOPER@\0"
            VALUE "FileDescription", "@MUSE_APP_NAME_HUMAN_READABLE@ music notation and production workstation\0"
            VALUE "FileVersion", "@MUSE_APP_VERSION@\0"
            VALUE "InternalName", "@MUSE_APP_NAME_MACHINE_READABLE@\0"
            VALUE "LegalCopyright", "Copyright 2026 @MUSE_APP_DEVELOPER@; MuseScore contributors\0"
            VALUE "OriginalFilename", "@MUSE_APP_NAME_MACHINE_READABLE@.exe\0"
            VALUE "ProductName", "@MUSE_APP_NAME_HUMAN_READABLE@\0"
            VALUE "ProductVersion", "@MUSE_APP_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
